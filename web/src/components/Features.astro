---
import Icon from "./Icon.astro";
import type { IconName } from "../lib/icons";

const features: { icon: IconName; title: string; body: string }[] = [
  {
    icon: "speaker",
    title: "The display you already know",
    body: "Every change shows the same volume and brightness display as the keys on your keyboard.",
  },
  {
    icon: "haptic",
    title: "A tick at every step",
    body: "Force Touch trackpads give a light haptic tick under your finger, from off to strong.",
  },
  {
    icon: "cursor",
    title: "Cursor freeze",
    body: "The pointer stays still and hidden while you slide, so nothing on screen moves by accident.",
  },
  {
    icon: "sliders",
    title: "Fine control",
    body: "Hold Shift-Option, or switch on Precise sliding, for quarter steps without the keys.",
  },
  {
    icon: "menuBar",
    title: "Lives in the menu bar",
    body: "No Dock icon and nothing in your way. Live levels and everyday settings sit one click away.",
  },
  {
    icon: "shield",
    title: "Private by design",
    body: "No network access and no analytics. Touch positions stay in memory and never leave your Mac.",
  },
];

const settings = [
  "Swap sides",
  "Bottom quarter only",
  "Require Fn or Option",
  "Reverse swipe",
  "Edge width",
  "Sensitivity",
  "Haptic strength",
  "Magic Mouse",
  "Open at login",
  "Light or dark",
];
---

<section id="features" class="section" aria-labelledby="features-title">
  <div class="container">
    <p class="eyebrow" data-reveal>Features</p>
    <h2 id="features-title" class="h2" data-reveal>Feels like it shipped with your Mac.</h2>
    <p class="lede" data-reveal>
      TrackEdge leans on what macOS already does well. It sends the system's own media keys, so every app, speaker, and
      display just works.
    </p>

    <ul class="grid">
      {
        features.map((feature, index) => (
          <li class="card glass" data-reveal style={`--reveal-delay: ${(index % 3) * 80}ms`}>
            <span class="card-icon">
              <Icon name={feature.icon} size={22} />
            </span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </li>
        ))
      }
    </ul>

    <div class="settings" data-reveal>
      <p class="settings-title">Make it yours</p>
      <ul>
        {settings.map((setting) => <li>{setting}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: clamp(48px, 7vw, 80px) 0 0;
    padding: 0;
    list-style: none;
  }

  .card {
    position: relative;
    padding: 28px;
    overflow: hidden;
    transition: border-color 0.3s var(--ease-out);
  }

  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 50% at 0% 0%, rgb(100 210 255 / 0.1), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
    pointer-events: none;
  }

  .card:hover {
    border-color: var(--line-strong);
  }

  .card:hover::before {
    opacity: 1;
  }

  .card-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 13px;
    background: linear-gradient(180deg, rgb(100 210 255 / 0.16), rgb(94 92 230 / 0.12));
    box-shadow: inset 0 0 0 1px rgb(100 210 255 / 0.22);
    color: var(--cyan);
  }

  .card h3 {
    margin: 22px 0 0;
    font-size: 18px;
    font-weight: 560;
    letter-spacing: -0.025em;
  }

  .card p {
    margin: 8px 0 0;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.55;
  }

  .settings {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }

  .settings-title {
    margin: 0;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .settings ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .settings li {
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    font-size: 13px;
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
