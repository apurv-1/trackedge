---
import "../styles/global.css";
import { product, repo, sitePath } from "../lib/site";
import type { RepoStats } from "../lib/github";

interface Props {
  title: string;
  description: string;
  stats: RepoStats;
}

const { title, description, stats } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(sitePath("og.jpg"), Astro.site);

// Structured data lets search engines show TrackEdge as a free Mac app.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: product.name,
  description: product.description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: `${product.minimumMacOS} or later`,
  url: canonical.href,
  image: new URL(sitePath("app-icon.png"), Astro.site).href,
  downloadUrl: repo.download,
  softwareVersion: stats.release?.version,
  license: "https://opensource.org/licenses/MIT",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Person", name: "Apurv Gupta", url: `https://github.com/${repo.owner}` },
  codeRepository: repo.url,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#06070b" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" type="image/png" href={sitePath("favicon.png")} />
    <link rel="apple-touch-icon" href={sitePath("apple-touch-icon.png")} />
    <link rel="sitemap" href={sitePath("sitemap-index.xml")} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={product.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TrackEdge: volume and brightness on your trackpad's edges" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
